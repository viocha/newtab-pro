{
  "name": "newtab-pro",
  "description": "高效美观的新标签页，支持多分组与小组管理、拖拽排序、左侧标签页快速拖入添加书签、数据导入导出。",
  "private": true,
  "version": "1.21.7",
  "packageManager": "bun@1",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "build": "bun run typecheck && wxt build",
    "reload": "reload-extension \"Newtab Pro\"",
    "build:reload": "bun run build && bun run reload",
    "zip": "wxt zip",
    "typecheck": "bun check",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@tailwindcss/vite": "^4.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.4.0",
    "jsondiffpatch": "^0.7.3",
    "lucide-react": "^0.575.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "shadcn": "^4.21.4",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.3.3",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@types/chrome": "^0.1.37",
    "@types/react": "^19.2.13",
    "@types/react-dom": "^19.2.3",
    "@wxt-dev/module-react": "^1.2.2",
    "reload-extension": "^0.3.7",
    "tw-animate-css": "^1.4.0",
    "wxt": "^0.21.4",
    "vite": "^8.3.5",
    "web-ext": "^10.8.0"
  }
}
